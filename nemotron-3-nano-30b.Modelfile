FROM nemotron-3-nano:30b
# 
# Author: NVIDIA
# Source: official Ollama library params + Dundee model metadata (2026-04-10)
# Size on disk: 24.3 GB
# Size running: 
# ollama show config-nemotron-3-nano-30b && ollama run config-nemotron-3-nano-30b "what llm model are you"
#  architecture        nemotron_h_moe
#  parameters          31.6B
#  context length      1048576
#  quantization        Q4_K_M
#  official params     temperature=1, top_p=1
#  note                Official Ollama params retained; 1M supported context, but default cap kept at 131072.

PARAMETER temperature 1
PARAMETER top_p 1
PARAMETER num_ctx 131072
