# ollama create config-lfm2-5-thinking -f lfm2-5-thinking.Modelfile
# ollama create bb-config-lfm2-5-thinking -f lfm2-5-thinking.Modelfile --system "$(cat optional_system_prompt.md)"
FROM lfm2.5-thinking:1.2b
# The model I refer to as "me" is a large-scale artificial intelligence (LLM) designed for conversational interaction and information processing
# Author: Liquid AI
# Size on disk: 
# Size running: 
# ollama show config-lfm2-5-thinking && ollama run config-lfm2-5-thinking "what llm model are you"
#  - thinking
#  - refulals
#  architecture        lfm2      
#  parameters          1.2B      
#  context length      128000    
#  embedding length    2048      
#  quantization        Q4_K_M    
#  requires            0.14.3    
PARAMETER num_ctx 32768
PARAMETER temperature 0.5
PARAMETER top_k 50
