FROM glm-4.7-flash:q4_K_M
# I am GLM, a large language model developed by Z.ai
# Author: 
# Size on disk: 
# Size running: 33 GB    87%/13% CPU/GPU
# ollama show config-glm-4-7-flash-q4_K_M && ollama run config-glm-4-7-flash-q4_K_M "what llm model are you"
#  - thinking
